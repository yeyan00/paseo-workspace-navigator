{
  "name": "paseo-workspace-navigator",
  "version": "0.1.0",
  "description": "Browse Paseo workspaces by host and project, with running-first and execution-time sorting.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yeyan00/paseo-workspace-navigator.git"
  },
  "files": [
    "README.zh-CN.md",
    "paseo-plugin.json",
    "OVERVIEW.md",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "shared/",
    "assets/",
    "!**/*.test.*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "preview": "vite --host 127.0.0.1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm test && npm run format:check",
    "check:package": "node scripts/check-package.mjs",
    "check:install": "node scripts/check-install.mjs"
  },
  "devDependencies": {
    "@getpaseo/client": "0.11.4",
    "@getpaseo/plugin": "0.11.4",
    "@getpaseo/protocol": "0.11.4",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.1.0",
    "esbuild": "^0.27.0",
    "lucide-react": "^0.468.0",
    "prettier": "^3.6.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "^0.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.1.0",
    "zod": "^4.4.3"
  }
}
